# Configuración General
ENVIRONMENT=dev
AWS_REGION=us-east-1

# Proveedor de IA: bedrock, openai, anthropic, google
AI_PROVIDER=bedrock

# Modelo a utilizar (varía según proveedor)
# Bedrock: amazon.nova-lite-v1:0, amazon.nova-pro-v1:0, anthropic.claude-3-5-sonnet-20241022-v2:0
# OpenAI: gpt-4o, gpt-4-turbo
# Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
# Google: gemini-2.0-flash, gemini-1.5-pro
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# API Keys (solo para proveedores externos)
# Dejar vacío si usa Bedrock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Token de autenticación para API de catálogo
CATALOG_API_TOKEN=poc-vision-api-token-2026
